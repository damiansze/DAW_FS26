flowchart TD
    %% ── IMPORT ──────────────────────────────────────────────
    subgraph IMP["1 · Import"]
        I1["public_emdat_1991_2024.xlsx
        (Excel)"]
        I2["omi_climate_sl_...nc
        (NetCDF)"]
    end

    %% ── PRE-FILTER ──────────────────────────────────────────
    subgraph PF["2 · Pre-Filter"]
        PF1["Irrelevante Spalten entfernen
        (18 EMDAT-Spalten / 3 Sea-Level-Spalten)"]
        PF2["EMDAT: Einträge ausserhalb
        Sea-Level-Abdeckung entfernen"]
        PF1 --> PF2
    end

    %% ── CLEANING ────────────────────────────────────────────
    subgraph CL["3 · Cleaning"]
        CL1["Duplikate entfernen
        (EMDAT: DisNo. / Sea Level: time)"]
        CL2["EMDAT: Unmögliche Daten entfernen
        (End Year < Start Year)"]
        CL3["EMDAT: Einträge ohne Start Year entfernen"]
        CL4["Sea Level: Fehlende Messwerte
        per linearer Interpolation imputieren"]
        CL1 --> CL2 --> CL3
        CL1 --> CL4
    end

    %% ── POST-FILTER ─────────────────────────────────────────
    subgraph POSTF["4 · Post-Filter"]
        F1["Nur Flood-Ereignisse behalten
        (Disaster Type / Disaster Subtype)"]
        F2["Nur Mittelmeerländer behalten
        (ISO-Ländercodes)"]
        F1 --> F2
    end

    %% ── TRANSFORM ───────────────────────────────────────────
    subgraph TR["5 · Transform"]
        TR1["Datum konstruieren
        (start_date, end_date aus Year/Month/Day)
        + Datenqualität dokumentieren"]
        TR2["Abgeleitete Spalten hinzufügen
        (season, event_duration_days, has_coordinates)"]
        TR1 --> TR2
    end

    %% ── JOIN & ANREICHERUNG ─────────────────────────────────
    subgraph JN["6 · Join & Anreicherung"]
        J1["Sea-Level Join (tagesgenau)
        sea_level_at_start, sea_trend_at_start
        sea_level_at_end, mean_sea_level_while_disaster"]
        J2["Sea-Level Lags hinzufügen
        (sea_level_lag_1d … sea_level_lag_5d)"]
        J3["Z-Scores berechnen
        (sea_level_at_start_z,
        mean_sea_level_while_disaster_z)"]
        J4["Redundante Spalten entfernen"]
        J1 --> J2 --> J3 --> J4
    end

    %% ── EXPORT ──────────────────────────────────────────────
    subgraph EX["7 · Export"]
        E1["data/processed/flood_linked.parquet"]
    end

    %% ── VERBINDUNGEN ─────────────────────────────────────────
    I1 --> PF1
    I2 --> PF1
    PF2 --> CL1
    CL3 --> F1
    CL4 --> J1
    F2 --> TR1
    TR2 --> J1
    J4 --> E1
